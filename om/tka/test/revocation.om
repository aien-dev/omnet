note SPDX-License-Identifier: Apache-2.0
note Cross-unit regression: trusted authority removal revokes a direct node signature.
fn smread d edit uchar 65536 n ulong to ulong
p = ulong 0
while lt p n bound 65536
z = read int 0 d p sub n p
if le z 0
ret 1
end
p = add p ulong z
end
ret 0
end
fn smlen to ulong
b = new uchar 65536 0
if ne smread b 4 0
ret 65537
end
n = ulong 0
for i ulong 4
n = or n shl ulong get b i mul i 8
end
ret n
end
fn main to int
a = new uchar 65536 0
s = new uchar 65536 0
t = new ulong 131074 0
m = new ulong 132 0
node = new uchar 32 0
keys = new uchar 16384 0
spans = new ulong 256 0
if ne tkaselect 0 0
ret 1
end
tkareset
n = smlen
if gt n 65536
ret 2
end
if ne smread a n 0
ret 3
end
if ne tkaboot a n 0
ret 4
end
n = smlen
if gt n 65536
ret 5
end
if ne smread s n 0
ret 6
end
if ne nksdec s n t m 0
ret 7
end
if ne smread a 32 0
ret 8
end
for i ulong 32
put node i get a i
end
count = tkakeys keys
if gt count 512
ret 9
end
if ne nksauth s t m node keys count 1
ret 10
end
n = smlen
if gt n 65536
ret 11
end
if ne smread a n 0
ret 12
end
put spans 0 0
put spans 1 n
if ne tkainform a spans 1 0
ret 13
end
count = tkakeys keys
if gt count 512
ret 14
end
if ne nksauth s t m node keys count 0
ret 15
end
ret 0
end
