note Bounded JSON syntax, decoded tokens, exact integer conversion and output.
const jsonbad ulong 65537

fn jsonbyte o edit uchar 65536 p ulong b uchar to ulong
if ge p 65536
ret jsonbad
end
put o p b
ret add p 1
end

fn jsonraw o edit uchar 65536 p ulong s view uchar 65536 n ulong to ulong
if or gt p 65536 gt n 65536
ret jsonbad
end
if gt n sub ulong 65536 p
ret jsonbad
end
for i ulong n
put o add p i get s i
end
ret add p n
end

fn jsonhex c ulong to ulong
if and ge c 48 le c 57
ret sub c 48
end
if and ge c 65 le c 70
ret sub c 55
end
if and ge c 97 le c 102
ret sub c 87
end
ret 16
end

fn jsonh4 s view uchar 65536 p ulong n ulong to ulong
if gt add p 4 n
ret 65536
end
v = ulong 0
for i ulong 4
c = jsonhex ulong get s add p i
if eq c 16
ret 65536
end
v = add mul v 16 c
end
ret v
end

note Decode one UTF8 scalar. Bad sequences consume one byte, matching Go.
fn jsonutf s view uchar 65536 p ulong n ulong r edit ulong 2 to void
put r 0 65533
put r 1 1
c = ulong get s p
if lt c 128
put r 0 c
ret
end
w = ulong 0
v = ulong 0
if and ge c 194 le c 223
w = 2
v = and c 31
end
if and ge c 224 le c 239
w = 3
v = and c 15
end
if and ge c 240 le c 244
w = 4
v = and c 7
end
if or eq w 0 gt add p w n
ret
end
i = ulong 1
while lt i w bound 4
c = ulong get s add p i
if or lt c 128 gt c 191
ret
end
v = add mul v 64 and c 63
i = add i 1
end
if and eq w 3 lt v 2048
ret
end
if and eq w 4 lt v 65536
ret
end
if or gt v 1114111 and ge v 55296 le v 57343
ret
end
put r 0 v
put r 1 w
end

fn jsonrune o edit uchar 65536 p ulong v ulong to ulong
if lt v 128
ret jsonbyte o p uchar v
end
if lt v 2048
p = jsonbyte o p uchar add ulong 192 shr v 6
else
if lt v 65536
p = jsonbyte o p uchar add ulong 224 shr v 12
else
p = jsonbyte o p uchar add ulong 240 shr v 18
p = jsonbyte o p uchar add ulong 128 and shr v 12 63
end
p = jsonbyte o p uchar add ulong 128 and shr v 6 63
end
ret jsonbyte o p uchar add ulong 128 and v 63
end

note State: input length, cursor, decoded length, token count, parent, depth.
fn jsonesc s view uchar 65536 st edit ulong 8 to ulong
p = get st 1
n = get st 0
if ge p n
ret 1114112
end
c = ulong get s p
put st 1 add p 1
if or eq c 34 or eq c 47 eq c 92
ret c
end
if eq c 98
ret 8
end
if eq c 102
ret 12
end
if eq c 110
ret 10
end
if eq c 114
ret 13
end
if eq c 116
ret 9
end
if ne c 117
ret 1114112
end
p = add p 1
c = jsonh4 s p n
if eq c 65536
ret 1114112
end
p = add p 4
put st 1 p
if and ge c 55296 le c 56319
if le add p 6 n
if and eq get s p 92 eq get s add p 1 117
v = jsonh4 s add p 2 n
if and ge v 56320 le v 57343
put st 1 add p 6
ret add ulong 65536 add mul sub c 55296 1024 sub v 56320
end
end
end
end
if and ge c 55296 le c 57343
ret 65533
end
ret c
end

fn jsonstring s view uchar 65536 st edit ulong 8 d edit uchar 65536 to int
r = new ulong 2 0
put st 1 add get st 1 1
while lt get st 1 get st 0 bound 65536
p = get st 1
c = ulong get s p
put st 1 add p 1
if eq c 34
ret 0
end
if lt c 32
ret 1
end
if eq c 92
c = jsonesc s st
if gt c 1114111
ret 1
end
else
if ge c 128
jsonutf s p get st 0 r
c = get r 0
put st 1 add p get r 1
end
end
p = jsonrune d get st 2 c
if eq p jsonbad
ret 2
end
put st 2 p
end
ret 1
end

fn jsondigit c uchar to bool
ret and ge c 48 le c 57
end

fn jsonnumber s view uchar 65536 st edit ulong 8 d edit uchar 65536 to int
p = get st 1
beg = p
n = get st 0
if eq get s p 45
p = add p 1
end
if ge p n
ret 1
end
if eq get s p 48
p = add p 1
else
if not jsondigit get s p
ret 1
end
while lt p n bound 65536
if not jsondigit get s p
break
end
p = add p 1
end
end
if lt p n
if eq get s p 46
p = add p 1
begd = p
while lt p n bound 65536
if not jsondigit get s p
break
end
p = add p 1
end
if eq p begd
ret 1
end
end
end
if lt p n
if or eq get s p 101 eq get s p 69
p = add p 1
if lt p n
if or eq get s p 43 eq get s p 45
p = add p 1
end
end
begd = p
while lt p n bound 65536
if not jsondigit get s p
break
end
p = add p 1
end
if eq p begd
ret 1
end
end
end
cnt = sub p beg
if gt cnt sub ulong 65536 get st 2
ret 2
end
for i ulong cnt
put d add get st 2 i get s add beg i
end
put st 2 add get st 2 cnt
put st 1 p
ret 0
end

fn jsonoctet v ulong i ulong to uchar
ret uchar and shr v mul i 8 255
end

fn jsonliteral s view uchar 65536 st edit ulong 8 kind ulong to int
p = get st 1
n = ulong 4
v = ulong 1702195828
if eq kind 6
n = 5
v = 435728179558
end
if eq kind 7
v = 1819047278
end
if gt add p n get st 0
ret 1
end
for i ulong n
if ne get s add p i jsonoctet v i
ret 1
end
end
put st 1 add p n
ret 0
end

fn jsonequal d view uchar 65536 a ulong b ulong n ulong to bool
for i ulong n
if ne get d add a i get d add b i
ret false
end
end
ret true
end

fn jsonkeyeq t view ulong 32768 d view uchar 65536 a ulong b ulong to bool
if ne get t add a 2 get t add b 2
ret false
end
ret jsonequal d get t add a 1 get t add b 1 get t add b 2
end

fn jsondupe t view ulong 32768 d view uchar 65536 id ulong to bool
b = mul id 8
par = get t add b 4
i = add par 1
while lt i id bound 4096
a = mul i 8
if eq get t add a 6 1
if jsonkeyeq t d a b
ret true
end
end
i = get t add a 3
end
ret false
end

fn jsonfinish t edit ulong 32768 st view ulong 8 b ulong to void
put t add b 2 sub get st 2 get t add b 1
end

fn jsonvalue s view uchar 65536 st edit ulong 8 t edit ulong 32768 d edit uchar 65536 key ulong to int
if ge get st 3 4095
ret 3
end
id = add get st 3 1
put st 3 id
b = mul id 8
for i ulong 8
put t add b i 0
end
put t b 4
put t add b 1 get st 2
put t add b 3 add id 1
put t add b 4 get st 4
put t add b 6 key
c = get s get st 1
if or eq c 123 eq c 91
if ge get st 5 32
ret 4
end
put t b 1
if eq c 91
put t b 2
end
put st 4 id
put st 5 add get st 5 1
put st 1 add get st 1 1
ret 0
end
e = int 0
if eq c 34
put t b 3
e = jsonstring s st d
else
if or eq c 116 or eq c 102 eq c 110
put t b 5
if eq c 102
put t b 6
end
if eq c 110
put t b 7
end
e = jsonliteral s st get t b
else
e = jsonnumber s st d
end
end
if ne e 0
ret e
end
jsonfinish t st b
if eq key 1
if jsondupe t d id
ret 5
end
end
ret 0
end

fn jsonspace c uchar to bool
ret or eq c 32 or eq c 9 or eq c 10 eq c 13
end

note Container phase 0 initial, 1 separator, 2 after comma, 3 colon, 4 object value.
fn jsonstep s view uchar 65536 st edit ulong 8 t edit ulong 32768 d edit uchar 65536 to int
par = get st 4
b = mul par 8
phase = get t add b 7
c = get s get st 1
obj = eq get t b 1
if or eq phase 0 eq phase 1
if or and obj eq c 125 and not obj eq c 93
put t add b 3 add get st 3 1
put st 4 get t add b 4
put st 5 sub get st 5 1
put st 1 add get st 1 1
ret 0
end
end
if eq phase 1
if ne c 44
ret 1
end
put t add b 7 2
put st 1 add get st 1 1
ret 0
end
if eq phase 3
if ne c 58
ret 1
end
put t add b 7 4
put st 1 add get st 1 1
ret 0
end
key = ulong 0
put t add b 7 1
if and obj ne phase 4
if ne c 34
ret 1
end
if ge get t add b 5 512
ret 6
end
key = 1
put t add b 7 3
end
put t add b 5 add get t add b 5 1
ret jsonvalue s st t d key
end

fn jsonparse s view uchar 65536 n ulong t edit ulong 32768 d edit uchar 65536 to int
put t 0 0
if or eq n 0 gt n 65536
ret 2
end
st = new ulong 8 0
put st 0 n
e = int 0
while lt get st 1 n bound 65536
if jsonspace get s get st 1
put st 1 add get st 1 1
else
if eq get st 4 0
if ne get st 3 0
ret 1
end
e = jsonvalue s st t d 0
else
e = jsonstep s st t d
end
if ne e 0
ret e
end
end
end
if or ne get st 4 0 eq get st 3 0
ret 1
end
put t 0 get st 3
ret 0
end

fn jsonuint d view uchar 65536 off ulong n ulong r edit ulong 1 to int
put r 0 0
if or gt off 65536 or eq n 0 gt n 20
ret 1
end
if gt n sub ulong 65536 off
ret 1
end
if and gt n 1 eq get d off 48
ret 1
end
v = ulong 0
for i ulong n
c = ulong get d add off i
if or lt c 48 gt c 57
ret 1
end
c = sub c 48
if gt v div sub ulong 18446744073709551615 c 10
ret 1
end
v = add mul v 10 c
end
put r 0 v
ret 0
end

fn jsonint d view uchar 65536 off ulong n ulong r edit long 1 to int
put r 0 0
if or ge off 65536 eq n 0
ret 1
end
negv = eq get d off 45
if negv
off = add off 1
n = sub n 1
end
v = new ulong 1 0
if ne jsonuint d off n v 0
ret 1
end
x = get v 0
if negv
if gt x 9223372036854775808
ret 1
end
if eq x 9223372036854775808
put r 0 -9223372036854775808
ret 0
end
put r 0 neg long x
else
if gt x 9223372036854775807
ret 1
end
put r 0 long x
end
ret 0
end

fn jsoncopy t view ulong 32768 d view uchar 65536 id ulong o edit uchar 65536 to ulong
if or eq id 0 gt id get t 0
ret jsonbad
end
b = mul id 8
n = get t add b 2
for i ulong n
put o i get d add get t add b 1 i
end
ret n
end

fn jsonname d view uchar 65536 off ulong key view uchar 65536 n ulong to bool
for j ulong n
if ne get key j get d add off j
ret false
end
end
ret true
end

fn jsonfind t view ulong 32768 d view uchar 65536 obj ulong key view uchar 65536 n ulong to ulong
if or eq obj 0 gt obj get t 0
ret 0
end
if or ne get t mul obj 8 1 gt n 65536
ret 0
end
i = add obj 1
while lt i get t add mul obj 8 3 bound 4096
b = mul i 8
if eq n get t add b 2
if jsonname d get t add b 1 key n
ret add i 1
end
end
i = get t add mul add i 1 8 3
end
ret 0
end

fn jsonhc v ulong to uchar
if lt v 10
ret uchar add v 48
end
ret uchar add v 87
end

fn jsonuesc o edit uchar 65536 p ulong v ulong to ulong
p = jsonbyte o p 92
p = jsonbyte o p 117
p = jsonbyte o p jsonhc and shr v 12 15
p = jsonbyte o p jsonhc and shr v 8 15
p = jsonbyte o p jsonhc and shr v 4 15
ret jsonbyte o p jsonhc and v 15
end

fn jsonneeds v ulong to bool
ret or lt v 32 or eq v 60 or eq v 62 or eq v 38 or eq v 8232 eq v 8233
end

fn jsonquote o edit uchar 65536 p ulong s view uchar 65536 off ulong n ulong to ulong
if or gt n 65536 gt off 65536
ret jsonbad
end
if gt n sub ulong 65536 off
ret jsonbad
end
n = add off n
p = jsonbyte o p 34
i = off
r = new ulong 2 0
while lt i n bound 65536
jsonutf s i n r
v = get r 0
i = add i get r 1
if or eq v 34 eq v 92
p = jsonbyte o p 92
p = jsonbyte o p uchar v
else
if jsonneeds v
c = ulong 0
if eq v 8
c = 98
end
if eq v 9
c = 116
end
if eq v 10
c = 110
end
if eq v 12
c = 102
end
if eq v 13
c = 114
end
if ne c 0
p = jsonbyte o p 92
p = jsonbyte o p uchar c
else
p = jsonuesc o p v
end
else
if and eq v 65533 eq get r 1 1
p = jsonrune o p v
else
p = jsonrune o p v
end
end
end
if eq p jsonbad
ret jsonbad
end
end
ret jsonbyte o p 34
end

fn jsonstr o edit uchar 65536 p ulong s view uchar 65536 n ulong to ulong
ret jsonquote o p s 0 n
end

fn jsonu64 o edit uchar 65536 p ulong v ulong to ulong
buf = new uchar 20 0
n = ulong 0
while ne v 0 bound 20
put buf n uchar add rem v 10 48
n = add n 1
v = div v 10
end
if eq n 0
ret jsonbyte o p 48
end
while gt n 0 bound 20
n = sub n 1
p = jsonbyte o p get buf n
end
ret p
end

fn jsoni64 o edit uchar 65536 p ulong v long to ulong
if ge v 0
ret jsonu64 o p ulong v
end
p = jsonbyte o p 45
if eq v -9223372036854775808
ret jsonu64 o p 9223372036854775808
end
ret jsonu64 o p ulong neg v
end

fn jsonspan o edit uchar 65536 p ulong s view uchar 65536 off ulong n ulong to ulong
if or gt off 65536 gt n 65536
ret jsonbad
end
if gt n sub ulong 65536 off
ret jsonbad
end
if gt p 65536
ret jsonbad
end
if gt n sub ulong 65536 p
ret jsonbad
end
for i ulong n
put o add p i get s add off i
end
ret add p n
end

fn jsonword o edit uchar 65536 p ulong v ulong n ulong to ulong
for i ulong n
p = jsonbyte o p uchar and shr v mul i 8 255
end
ret p
end

fn jsonatom t view ulong 32768 d view uchar 65536 id ulong o edit uchar 65536 p ulong to ulong
b = mul id 8
k = get t b
if eq k 1
ret jsonbyte o p 123
end
if eq k 2
ret jsonbyte o p 91
end
if eq k 3
ret jsonquote o p d get t add b 1 get t add b 2
end
if eq k 4
ret jsonspan o p d get t add b 1 get t add b 2
end
if eq k 5
ret jsonword o p 1702195828 4
end
if eq k 6
ret jsonword o p 435728179558 5
end
ret jsonword o p 1819047278 4
end

fn jsoncomma t view ulong 32768 b ulong par ulong to bool
ret or eq get t mul par 8 2 eq get t add b 6 1
end

note Token table must be from a successful parse and unmodified.
fn jsonencode t view ulong 32768 d view uchar 65536 o edit uchar 65536 to ulong
if or eq get t 0 0 gt get t 0 4095
ret jsonbad
end
p = ulong 0
cur = ulong 0
id = ulong 1
while le id get t 0 bound 4095
b = mul id 8
par = get t add b 4
while ne cur par bound 32
c = uchar 125
if eq get t mul cur 8 2
c = 93
end
p = jsonbyte o p c
cur = get t add mul cur 8 4
end
if ne par 0
if gt id add par 1
if jsoncomma t b par
p = jsonbyte o p 44
end
end
end
p = jsonatom t d id o p
if eq get t add b 6 1
p = jsonbyte o p 58
end
if le get t b 2
cur = id
end
if eq p jsonbad
ret jsonbad
end
id = add id 1
end
while ne cur 0 bound 32
c = uchar 125
if eq get t mul cur 8 2
c = 93
end
p = jsonbyte o p c
cur = get t add mul cur 8 4
end
ret p
end
