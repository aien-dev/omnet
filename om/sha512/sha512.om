note H(0) for SHA-512: first 64 bits of the fractional parts of the square roots of the first 8 primes
note (FIPS 180-4 section 5.3.5)
fn s512iv h edit ulong 8 to void
put h 0 7640891576956012808
put h 1 13503953896175478587
put h 2 4354685564936845355
put h 3 11912009170470909681
put h 4 5840696475078001361
put h 5 11170449401992604703
put h 6 2270897969802886507
put h 7 6620516959819538809
end

note upper-case Sigma0{512}(x) = ROTR^28 ^ ROTR^34 ^ ROTR^39 (FIPS 180-4 section 4.1.3, (4.10))
fn s512bs0 x ulong to ulong
r = or shr x 28 shl x 36
r = xor r or shr x 34 shl x 30
r = xor r or shr x 39 shl x 25
ret r
end

note upper-case Sigma1{512}(x) = ROTR^14 ^ ROTR^18 ^ ROTR^41 (section 4.1.3, (4.11))
fn s512bs1 x ulong to ulong
r = or shr x 14 shl x 50
r = xor r or shr x 18 shl x 46
r = xor r or shr x 41 shl x 23
ret r
end

note lower-case sigma0{512}(x) = ROTR^1 ^ ROTR^8 ^ SHR^7 (section 4.1.3, (4.12))
fn s512ss0 x ulong to ulong
r = or shr x 1 shl x 63
r = xor r or shr x 8 shl x 56
r = xor r shr x 7
ret r
end

note lower-case sigma1{512}(x) = ROTR^19 ^ ROTR^61 ^ SHR^6 (section 4.1.3, (4.13))
fn s512ss1 x ulong to ulong
r = or shr x 19 shl x 45
r = xor r or shr x 61 shl x 3
r = xor r shr x 6
ret r
end

note Ch(x,y,z) = (x and y) xor (not x and z), written as z xor (x and (y xor z)) (section 4.1.3, (4.8))
fn s512ch x ulong y ulong z ulong to ulong
ret xor z and x xor y z
end

note Maj(x,y,z) = (x and y) xor (x and z) xor (y and z), written as (x and y) or (z and (x or y))
note (section 4.1.3, (4.9))
fn s512mj x ulong y ulong z ulong to ulong
ret or and x y and z or x y
end

note big-endian 64-bit word of the 8 bytes at m[q..q+8) (section 3.1 item 3)
fn s512bem m view uchar 65536 q ulong to ulong
v = ulong 0
for j ulong 8
v = or shl v 8 ulong get m add q j
end
ret v
end

note the same for the 256-byte padding buffer
fn s512bep p view uchar 256 q ulong to ulong
v = ulong 0
for j ulong 8
v = or shl v 8 ulong get p add q j
end
ret v
end

note the same for the 64-byte prefix
fn s512bex p view uchar 64 q ulong to ulong
v = ulong 0
for j ulong 8
v = or shl v 8 ulong get p add q j
end
ret v
end

note message block M(i) at byte o of the stream p[0..pl) || m into w[0..16) (section 6.4.2 step 1,
note t = 0..15). pl is 0 or 64 and o is a multiple of 128, so every word lies wholly in p or in m.
fn s512ldm p view uchar 64 pl ulong m view uchar 65536 o ulong w edit ulong 80 to void
for i ulong 16
q = add o mul i 8
if lt q pl
put w i s512bex p q
else
put w i s512bem m sub q pl
end
end
end

note the block at byte o of the padding buffer pb into w[0..16)
fn s512ldp pb view uchar 256 o ulong w edit ulong 80 to void
for i ulong 16
put w i s512bep pb add o mul i 8
end
end

note one SHA-512 compression (section 6.4.2 steps 1-4); w[0..16) holds the block on entry
fn s512blk h edit ulong 8 w edit ulong 80 k view ulong 80 to void
for i ulong 64
t = add i 16
v = s512ss1 get w sub t 2
v = add v get w sub t 7
v = add v s512ss0 get w sub t 15
v = add v get w i
put w t v
end
a = get h 0
b = get h 1
c = get h 2
d = get h 3
e = get h 4
f = get h 5
g = get h 6
x = get h 7
for i ulong 80
t = add x s512bs1 e
t = add t s512ch e f g
t = add t get k i
t = add t get w i
u = add s512bs0 a s512mj a b c
x = g
g = f
f = e
e = add d t
d = c
c = b
b = a
a = add t u
end
put h 0 add get h 0 a
put h 1 add get h 1 b
put h 2 add get h 2 c
put h 3 add get h 3 d
put h 4 add get h 4 e
put h 5 add get h 5 f
put h 6 add get h 6 g
put h 7 add get h 7 x
end

note Padding (section 5.1.2) of the stream p[0..pl) || m, tot bytes long, whose bytes from off on
note (fewer than 128) are not yet compressed: they go to pb[0..r), then one 1 bit (byte 128), zero bytes
note up to 112 mod 128, then l = 8 * tot as a 128-bit big-endian integer. pb must be all zero on entry.
note Returns the padded length, 128 when r < 112, else 256. The upper 64 bits of l are always 0 here
note because tot <= 65600.
fn s512pad p view uchar 64 pl ulong m view uchar 65536 off ulong tot ulong pb edit uchar 256 to ulong
r = sub tot off
for i ulong r
q = add off i
if lt q pl
put pb i get p q
else
put pb i get m sub q pl
end
end
put pb r 128
e = ulong 128
if ge r 112
e = 256
end
s512len pb e mul tot 8
ret e
end

note the low 64 bits of the 128-bit big-endian length field ending at pb[e-1]
fn s512len pb edit uchar 256 e ulong bits ulong to void
for i ulong 8
y = sub sub e 1 i
put pb y uchar and shr bits mul i 8 255
end
end

note H(N) as the 64-byte big-endian digest (section 6.4.2, final hash value)
fn s512out h view ulong 8 o edit uchar 64 to void
for i ulong 8
v = get h i
for j ulong 8
put o add mul i 8 j uchar and shr v mul sub 7 j 8 255
end
end
end

note SHA-512 of the stream p[0..pl) || m[0..n), pl 0 or 64 (else trap 3), n <= 65536 (else trap 3),
note digest to o[0..64).
fn s512core p view uchar 64 pl ulong m view uchar 65536 n ulong o edit uchar 64 to void
if gt n 65536
trap 3
end
if ne pl 0
if ne pl 64
trap 3
end
end
h = new ulong 8 0
w = new ulong 80 0
k = new ulong 80 0
pb = new uchar 256 0
s512k k
s512iv h
tot = add pl n
off = ulong 0
while le add off 128 tot bound 514
s512ldm p pl m off w
s512blk h w k
off = add off 128
end
e = s512pad p pl m off tot pb
s512ldp pb 0 w
s512blk h w k
if eq e 256
s512ldp pb 128 w
s512blk h w k
end
s512out h o
end

note SHA-512(m[0..n)), n <= 65536 (else trap 3), digest to o[0..64)
fn s512hash m view uchar 65536 n ulong o edit uchar 64 to void
z = new uchar 64 0
s512core z 0 m n o
end

note SHA-512(p[0..64) || m[0..n)), n <= 65536 (else trap 3), digest to o[0..64); for Ed25519's
note SHA-512(R || A || M) without copying M (RFC 8032 section 5.1.7 step 2)
fn s512pre p view uchar 64 m view uchar 65536 n ulong o edit uchar 64 to void
s512core p 64 m n o
end
