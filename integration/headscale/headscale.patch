+				if interactive {
+					id := types.MustAuthID()
+					s.SetAuthCacheEntry(id, types.NewRegisterAuthRequest(&types.RegistrationData{
+						MachineKey: first.MachineKey, NodeKey: first.NodeKey,
+						TKAKey: key.NewNLPrivate().Public(), Hostname: "duplicate-target",
+						Hostinfo: &tailcfg.Hostinfo{Hostname: "duplicate-target"},
+					}))
+					_, _, err = s.HandleNodeFromAuthPath(id, types.UserID(secondUser.ID), nil, "oidc")
+				} else {
+					pak, pakErr := s.CreatePreAuthKey(secondUser.TypedID(), true, false, nil, nil)
+					require.NoError(t, pakErr)
+					_, _, err = s.HandleNodeFromPreAuthKey(tailcfg.RegisterRequest{
+						NodeKey: first.NodeKey, NLKey: key.NewNLPrivate().Public(),
+						Auth:     &tailcfg.RegisterResponseAuth{AuthKey: pak.Key},
+						Hostinfo: &tailcfg.Hostinfo{Hostname: "duplicate-target"},
+					}, first.MachineKey)
+				}
+				require.ErrorIs(t, err, ErrNodeKeyInUse)
+				s.TKAMu.Lock()
+				nodes, err := s.TKACommittedNodes(context.Background())
+				s.TKAMu.Unlock()
+				require.NoError(t, err, "refusal must leave a coherent unique roster")
+				wantCount := 1
+				if existingTarget {
+					wantCount = 2
+					stored, err := s.DB().GetNodeByID(second.ID)
+					require.NoError(t, err)
+					require.Equal(t, second.NodeKey, stored.NodeKey)
+				}
+				require.Len(t, nodes, wantCount)
+				stored, err := s.DB().GetNodeByID(first.ID)
+				require.NoError(t, err)
+				require.Equal(t, first.NodeKey, stored.NodeKey)
+				require.Equal(t, first.UserID, stored.UserID)
+			})
+		}
+	}
+}
+
+func TestOmnetReconcileFailureStillRefreshesCommittedPolicy(t *testing.T) {
+	for _, interactive := range []bool{false, true} {
+		t.Run(fmt.Sprintf("interactive=%t", interactive), func(t *testing.T) {
+			_, s, _ := persistTestSetup(t)
+			defer s.Close()
+			user := s.CreateUserForTest("outage-owner")
+			require.NoError(t, s.UpdatePolicyManagerUsersForTest())
+			_, err := s.SetPolicy([]byte(`{"grants":[{"src":["outage-owner@"],"dst":["*"],"ip":["*"]}]}`))
+			require.NoError(t, err)
+			before, _ := s.Filter()
+			outage := errors.New("injected post-commit outage")
+			var committedID types.NodeID
+			s.TKAReconcile = func(_ context.Context, id types.NodeID, _ []byte) error {
+				committedID = id
+				return outage
+			}
+			req := tailcfg.RegisterRequest{
+				NodeKey: key.NewNode().Public(), NLKey: key.NewNLPrivate().Public(),
+				Hostinfo: &tailcfg.Hostinfo{Hostname: "policy-outage-node"},
+			}
+			machine := key.NewMachine().Public()
+			if interactive {
+				id := types.MustAuthID()
+				request := types.NewRegisterAuthRequest(&types.RegistrationData{
+					MachineKey: machine, NodeKey: req.NodeKey, TKAKey: req.NLKey,
+					Hostname: req.Hostinfo.Hostname, Hostinfo: req.Hostinfo,
+				})
+				s.SetAuthCacheEntry(id, request)
+				_, _, err = s.HandleNodeFromAuthPath(id, types.UserID(user.ID), nil, "oidc")
+				require.ErrorIs(t, (<-request.WaitForAuth()).Err, outage)
+			} else {
+				pak, pakErr := s.CreatePreAuthKey(user.TypedID(), true, false, nil, nil)
+				require.NoError(t, pakErr)
+				req.Auth = &tailcfg.RegisterResponseAuth{AuthKey: pak.Key}
+				_, _, err = s.HandleNodeFromPreAuthKey(req, machine)
+			}
+			require.ErrorIs(t, err, outage)
+			stored, err := s.DB().GetNodeByID(committedID)
+			require.NoError(t, err)
+			require.Equal(t, req.NodeKey, stored.NodeKey)
+			after, _ := s.Filter()
+			require.NotEqual(t, before, after, "ACL sources must include the committed user node despite IPC failure")
+			usersChange, err := s.updatePolicyManagerUsers()
+			require.NoError(t, err)
+			nodesChange, err := s.updatePolicyManagerNodes()
+			require.NoError(t, err)
+			require.True(t, usersChange.IsEmpty())
+			require.True(t, nodesChange.IsEmpty(), "an unrelated later event must not be needed to heal policy")
+		})
+	}
+}
