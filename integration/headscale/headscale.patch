+func TestOmnetStoppedQueuedWriteCannotExtendStopDeadline(t *testing.T) {
+	h, n, _ := omnetApp(t)
+	w := &omnetBlockedWriter{ResponseRecorder: httptest.NewRecorder(), started: make(chan struct{}), release: make(chan struct{})}
+	close(w.release)
+	m := &mapSession{h: h, ctx: context.Background(), req: tailcfg.MapRequest{NodeKey: n.NodeKey}, node: &n, w: w, cancelCh: make(chan struct{})}
+	h.state.TKAMu.Lock()
+	done := make(chan error, 1)
+	go func() { done <- m.writeMap(&tailcfg.MapResponse{KeepAlive: true}) }()
+	require.Eventually(t, m.writing.Load, time.Second, time.Millisecond)
+	m.stopFromBatcher()
+	h.state.TKAMu.Unlock()
+	require.ErrorIs(t, <-done, errMapSessionStopped)
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	require.Len(t, w.deadlines, 1, "no later write may replace the stop deadline")
+	require.Empty(t, w.Body.Bytes())
+}
