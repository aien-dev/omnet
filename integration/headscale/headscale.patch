+func TestOmnetRegistrationOutboxSurvivesReconcileFailureAndRestart(t *testing.T) {
+	path, s, id := persistTestSetup(t)
+	old, err := s.DB().GetNodeByID(id)
+	require.NoError(t, err)
+	owner := types.UserID(*old.UserID)
+	pak, err := s.CreatePreAuthKey(&owner, true, false, nil, nil)
+	require.NoError(t, err)
+	req := tailcfg.RegisterRequest{
+		NodeKey: key.NewNode().Public(), NLKey: key.NewNLPrivate().Public(),
+		NodeKeySignature: []byte("untrusted-pending-signature"),
+		Auth:             &tailcfg.RegisterResponseAuth{AuthKey: pak.Key},
+		Hostinfo:         &tailcfg.Hostinfo{Hostname: "outbox-node"},
+	}
+	outage := errors.New("injected daemon outage")
+	called := false
+	s.TKAReconcile = func(ctx context.Context, _ types.NodeID, _ []byte) error {
+		called = true
+		nodes, err := s.TKACommittedNodes(ctx)
+		require.NoError(t, err)
+		require.Len(t, nodes, 1)
+		require.Equal(t, req.NodeKey, nodes[0].NodeKey)
+		require.Equal(t, req.NLKey, nodes[0].TKAKey)
+		require.Equal(t, []byte(req.NodeKeySignature), nodes[0].TKASignature)
+		return outage
+	}
+	_, _, err = s.HandleNodeFromPreAuthKey(req, old.MachineKey)
+	require.ErrorIs(t, err, outage)
+	require.True(t, called)
+	require.NoError(t, s.Close())
+	restarted := persistTestReopen(t, path)
+	durable, err := restarted.DB().GetNodeByID(id)
+	require.NoError(t, err)
+	require.Equal(t, req.NLKey, durable.TKAKey)
+	require.Equal(t, req.NodeKey, durable.NodeKey)
+	require.Equal(t, []byte(req.NodeKeySignature), durable.TKASignature)
+	// Accepted readback or definitive rejection followed by unsigned upsert clears the outbox.
+	restarted.TKAMu.Lock()
+	require.NoError(t, restarted.TKAAcknowledge(context.Background(), *durable))
+	restarted.TKAMu.Unlock()
+	durable, err = restarted.DB().GetNodeByID(id)
+	require.NoError(t, err)
+	require.Empty(t, durable.TKASignature)
+}
+
+func TestOmnetStaleMapCannotUndoRotation(t *testing.T) {
+	_, s, id := persistTestSetup(t)
+	defer s.Close()
+	old, err := s.DB().GetNodeByID(id)
+	require.NoError(t, err)
+	s.TKAReconcile = func(context.Context, types.NodeID, []byte) error { return nil }
+	owner := types.UserID(*old.UserID)
+	pak, err := s.CreatePreAuthKey(&owner, true, false, nil, nil)
+	require.NoError(t, err)
+	req := tailcfg.RegisterRequest{
+		NodeKey: key.NewNode().Public(), NLKey: key.NewNLPrivate().Public(),
+		Auth:     &tailcfg.RegisterResponseAuth{AuthKey: pak.Key},
+		Hostinfo: &tailcfg.Hostinfo{Hostname: old.Hostname},
+	}
+	_, _, err = s.HandleNodeFromPreAuthKey(req, old.MachineKey)
+	require.NoError(t, err)
+	_, err = s.UpdateNodeFromMapRequest(id, tailcfg.MapRequest{NodeKey: old.NodeKey})
+	require.ErrorContains(t, err, "stale map node identity")
+	current, err := s.DB().GetNodeByID(id)
+	require.NoError(t, err)
+	require.Equal(t, req.NodeKey, current.NodeKey)
+}
+
+func TestOmnetCommittedRosterRejectsSpeculativeIdentity(t *testing.T) {
+	_, s, id := persistTestSetup(t)
+	defer s.Close()
+	s.TKAReconcile = func(context.Context, types.NodeID, []byte) error { return nil }
+	s.nodeStore.UpdateNode(id, func(n *types.Node) { n.NodeKey = key.NewNode().Public() })
+	s.TKAMu.Lock()
+	_, err := s.TKACommittedNodes(context.Background())
+	s.TKAMu.Unlock()
+	require.ErrorContains(t, err, "uncommitted node identity")
+}
+
+func TestOmnetCommittedRosterRejectsDuplicateNodeKeys(t *testing.T) {
+	_, s, id := persistTestSetup(t)
+	defer s.Close()
+	first, err := s.DB().GetNodeByID(id)
