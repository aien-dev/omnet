+type omnetBlockedWriter struct {
+	*httptest.ResponseRecorder
+	started   chan struct{}
+	release   chan struct{}
+	once      sync.Once
+	mu        sync.Mutex
+	deadlines []time.Time
+}
+
+func (w *omnetBlockedWriter) Write(p []byte) (int, error) {
+	w.once.Do(func() { close(w.started); <-w.release })
+	return w.ResponseRecorder.Write(p)
+}
+
+func (w *omnetBlockedWriter) SetWriteDeadline(deadline time.Time) error {
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	w.deadlines = append(w.deadlines, deadline)
+	return nil
+}
+
+func TestOmnetSlowWriterReleasesBarrierAndKeepsFrameOrder(t *testing.T) {
+	h, n, f := omnetApp(t)
+	w := &omnetBlockedWriter{ResponseRecorder: httptest.NewRecorder(), started: make(chan struct{}), release: make(chan struct{})}
+	m := &mapSession{h: h, ctx: context.Background(), req: tailcfg.MapRequest{NodeKey: n.NodeKey}, node: &n, w: w}
+	msg := &tailcfg.MapResponse{Node: &tailcfg.Node{ID: n.ID.NodeID(), Key: n.NodeKey}}
+	done := make(chan error, 1)
+	go func() { done <- m.writeTKAMap(msg) }()
+	<-w.started
+	locked := h.state.TKAMu.TryLock()
+	if !locked {
+		close(w.release)
+		<-done
+		t.Fatal("client write holds the global publication barrier")
+	}
+	f.mu.Lock()
+	f.snapshot.Nodes[0].KeySignature = []byte("new-snapshot")
+	f.snapshot.Revision++
+	f.mu.Unlock()
+	h.state.TKAMu.Unlock()
+	other := httptest.NewRecorder()
+	peer := &mapSession{h: h, ctx: context.Background(), req: tailcfg.MapRequest{NodeKey: n.NodeKey}, node: &n, w: other}
+	err := peer.writeTKAMap(msg)
+	close(w.release)
+	require.NoError(t, <-done)
+	require.NoError(t, err, "another client's write must complete while the first is blocked")
+	require.NoError(t, m.writeTKAMap(msg))
+	wire := w.Body.Bytes()
+	for _, signature := range []string{"accepted-signature", "new-snapshot"} {
+		require.GreaterOrEqual(t, len(wire), 4)
+		size := int(binary.LittleEndian.Uint32(wire[:4]))
+		require.GreaterOrEqual(t, len(wire), 4+size)
+		var response tailcfg.MapResponse
+		require.NoError(t, json.Unmarshal(wire[4:4+size], &response))
+		require.Equal(t, []byte(signature), []byte(response.Node.KeySignature))
+		wire = wire[4+size:]
+	}
+	require.Empty(t, wire)
+}
