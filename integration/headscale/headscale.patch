+func TestOmnetDefinitiveRejectedOutboxIsLocal(t *testing.T) {
+	for _, status := range []int{http.StatusBadRequest, http.StatusForbidden, http.StatusConflict, http.StatusRequestEntityTooLarge} {
+		for _, rotated := range []bool{false, true} {
+			t.Run(fmt.Sprintf("%d/rotated=%t", status, rotated), func(t *testing.T) {
+				h, n, f := omnetApp(t)
+				if rotated {
+					n.NodeKey = key.NewNode().Public()
+				}
+				n.TKASignature = []byte("rejected-pending-signature")
+				if status == http.StatusRequestEntityTooLarge {
+					// Legacy persisted data from before encoded-envelope validation.
+					n.TKASignature = make([]byte, tkaBodyLimit)
+				}
+				require.NoError(t, h.state.DB().DB.Save(&n).Error)
+				h.state.PutNodeInStoreForTest(n)
+				f.mu.Lock()
+				f.rejectSignature = status
+				f.mu.Unlock()
+				failure := h.tkaFailure()
+				h.state.TKAMu.Lock()
+				err := h.tkad.reconcileRegistration(context.Background(), n.ID, n.TKASignature)
+				h.state.TKAMu.Unlock()
+				require.ErrorContains(t, err, "rejected node key signature")
+				stored, err := h.state.DB().GetNodeByID(n.ID)
+				require.NoError(t, err)
+				require.Empty(t, stored.TKASignature, "clear only the rejected forwarding outbox")
+				cached, ok := h.state.GetNodeByID(n.ID)
+				require.True(t, ok)
+				require.Empty(t, cached.AsStruct().TKASignature)
+				require.NoError(t, h.tkaMapReady(context.Background()))
+				select {
+				case <-failure:
+					t.Fatal("a rejected node signature stopped unrelated streams")
+				default:
+				}
+				f.mu.Lock()
+				require.Len(t, f.snapshot.Nodes, 1)
+				require.Equal(t, n.NodeKey, f.snapshot.Nodes[0].NodePublic)
+				if rotated {
+					require.Empty(t, f.snapshot.Nodes[0].KeySignature)
+				} else {
+					require.Equal(t, []byte("accepted-signature"), f.snapshot.Nodes[0].KeySignature)
+				}
+				f.mu.Unlock()
+				w := httptest.NewRecorder()
+				m := &mapSession{h: h, ctx: context.Background(), req: tailcfg.MapRequest{NodeKey: n.NodeKey}, node: &n, w: w}
+				require.NoError(t, m.writeTKAMap(&tailcfg.MapResponse{Node: &tailcfg.Node{ID: n.ID.NodeID(), Key: n.NodeKey}}))
+			})
+		}
+	}
