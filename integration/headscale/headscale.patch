+
+func TestOmnetRevisionFloorSurvivesAdapterRestart(t *testing.T) {
+	path, s, _ := persistTestSetup(t)
+	s.TKAMu.Lock()
+	require.NoError(t, s.TKACheckRevision(context.Background(), 19))
+	require.NoError(t, s.TKACheckRevision(context.Background(), 19))
+	s.TKAMu.Unlock()
+	require.NoError(t, s.Close())
+	restarted := persistTestReopen(t, path)
+	restarted.TKAMu.Lock()
+	defer restarted.TKAMu.Unlock()
+	require.ErrorContains(t, restarted.TKACheckRevision(context.Background(), 0), "revision regressed")
+	require.ErrorContains(t, restarted.TKACheckRevision(context.Background(), 18), "revision regressed")
+	require.NoError(t, restarted.TKACheckRevision(context.Background(), 20))
+	var checkpoint types.OmnetCheckpoint
+	require.NoError(t, restarted.DB().DB.First(&checkpoint, 1).Error)
+	require.Equal(t, uint64(20), checkpoint.Revision)
