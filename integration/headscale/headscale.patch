+func TestOmnetInteractiveCallbackPersistsBeforeAuthCompletion(t *testing.T) {
+	_, s, id := persistTestSetup(t)
+	defer s.Close()
+	old, err := s.DB().GetNodeByID(id)
+	require.NoError(t, err)
+	data := &types.RegistrationData{
+		MachineKey:   old.MachineKey,
+		NodeKey:      key.NewNode().Public(),
+		TKAKey:       key.NewNLPrivate().Public(),
+		TKASignature: []byte("interactive-pending-signature"),
+		Hostname:     old.Hostname,
+		Hostinfo:     &tailcfg.Hostinfo{Hostname: old.Hostname},
+	}
+	authID := types.MustAuthID()
+	request := types.NewRegisterAuthRequest(data)
+	s.SetAuthCacheEntry(authID, request)
+	outage := errors.New("interactive forwarding outage")
+	s.TKAReconcile = func(ctx context.Context, _ types.NodeID, _ []byte) error {
+		// This is the real callback boundary, after SQL commit but before
+		// FinishAuth can report success to the waiting stock client.
+		nodes, err := s.TKACommittedNodes(ctx)
+		require.NoError(t, err)
+		require.Len(t, nodes, 1)
+		require.Equal(t, data.NodeKey, nodes[0].NodeKey)
+		require.Equal(t, data.TKAKey, nodes[0].TKAKey)
+		require.Equal(t, data.TKASignature, nodes[0].TKASignature)
+		select {
+		case <-request.WaitForAuth():
+			t.Fatal("interactive authentication completed before reconciliation")
+		default:
+		}
+		return outage
+	}
+	_, _, err = s.HandleNodeFromAuthPath(authID, types.UserID(*old.UserID), nil, "oidc")
+	require.ErrorIs(t, err, outage)
+	verdict := <-request.WaitForAuth()
+	require.ErrorIs(t, verdict.Err, outage)
+	require.False(t, verdict.Node.Valid())
+	stored, err := s.DB().GetNodeByID(id)
+	require.NoError(t, err)
+	require.Equal(t, data.TKAKey, stored.TKAKey)
+	require.Equal(t, data.TKASignature, stored.TKASignature)
+}
