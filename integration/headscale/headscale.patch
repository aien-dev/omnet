+func TestOmnetAmbiguousAndUnauthorizedOutboxesRemainFailClosed(t *testing.T) {
+	for _, test := range []struct {
+		name           string
+		signedStatus   int
+		unsignedStatus int
+		drop           bool
+	}{
+		{"lost-accepted-reply", 0, 0, true},
+		{"server-error", http.StatusInternalServerError, 0, false},
+		{"unauthenticated-ipc", http.StatusUnauthorized, 0, false},
+		{"admin-denied-even-unsigned", http.StatusForbidden, http.StatusForbidden, false},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			h, n, f := omnetApp(t)
+			n.TKASignature = []byte("pending")
+			require.NoError(t, h.state.DB().DB.Save(&n).Error)
+			h.state.PutNodeInStoreForTest(n)
+			f.mu.Lock()
+			f.rejectSignature, f.rejectUnsigned = test.signedStatus, test.unsignedStatus
+			if test.drop {
+				f.dropReplyRoute = 9
+			}
+			f.mu.Unlock()
+			failure := h.tkaFailure()
+			require.Error(t, h.tkaMapReady(context.Background()))
+			stored, err := h.state.DB().GetNodeByID(n.ID)
+			require.NoError(t, err)
+			require.Equal(t, n.TKASignature, stored.TKASignature)
+			select {
+			case <-failure:
+			default:
+				t.Fatal("unresolved transport/auth failure must block publication")
+			}
+			if test.drop {
+				require.NoError(t, h.tkaMapReady(context.Background()), "readback resolves a lost successful reply")
+				stored, err = h.state.DB().GetNodeByID(n.ID)
+				require.NoError(t, err)
+				require.Empty(t, stored.TKASignature)
+				f.mu.Lock()
+				require.Equal(t, 1, f.writes, "accepted readback must not replay")
+				f.mu.Unlock()
+			}
+		})
+	}
+}
