+// This fixture tests glue only. Real Omega protocol/security behavior is
+// exercised by Omnet's native daemon suite and stock-client E2E, not simulated.
+type omnetFixture struct {
+	mu              sync.Mutex
+	snapshot        tkaSnapshot
+	writes          int
+	calls           []byte
+	lastHeader      [20]byte
+	badRead         bool
+	rejectSignature int
+	rejectUnsigned  int
+	dropReplyRoute  byte
+	beforeReply     func(byte)
