diff --git a/hscontrol/state/tka.go b/hscontrol/state/tka.go
new file mode 100644
index 0000000..0c2454a
--- /dev/null
+++ b/hscontrol/state/tka.go
@@ -0,0 +1,128 @@
+package state
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"slices"
+	"time"
+
+	"github.com/juanfont/headscale/hscontrol/types"
+	"gorm.io/gorm"
+	"tailscale.com/tailcfg"
+	"tailscale.com/types/key"
+)
+
+// lockTKA is the publication barrier for identity-changing state operations.
+// The optional callback is configured once, before any server goroutines start.
+func (s *State) lockTKA() func() {
+	if s.TKAReconcile == nil {
+		return func() {}
+	}
+	s.TKAMu.Lock()
+	return s.TKAMu.Unlock
+}
+
+func (s *State) reconcileTKA(id types.NodeID, signature []byte) error {
+	if s.TKAReconcile == nil {
+		return nil
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 8*time.Second)
+	defer cancel()
+	return s.TKAReconcile(ctx, id, signature)
+}
+
+// TKACheckRevision records the latest observed transport revision under TKAMu.
+// It catches empty/older snapshot replacement after restart. It cannot identify
+// an arbitrary different authority with a higher revision; same UID is trusted.
+func (s *State) TKACheckRevision(ctx context.Context, revision uint64) error {
+	var checkpoint types.OmnetCheckpoint
+	err := s.db.DB.WithContext(ctx).First(&checkpoint, 1).Error
+	if errors.Is(err, gorm.ErrRecordNotFound) {
+		return s.db.DB.WithContext(ctx).Create(&types.OmnetCheckpoint{ID: 1, Revision: revision}).Error
+	}
+	if err != nil {
+		return err
+	}
+	if revision < checkpoint.Revision {
+		return errors.New("omnet authority revision regressed")
+	}
+	if revision == checkpoint.Revision {
+		return nil
+	}
+	return s.db.DB.WithContext(ctx).Model(&checkpoint).Update("revision", revision).Error
+}
+
+// TKACommittedNodes must be called under TKAMu. It deliberately reads SQL,
+// not NodeStore: upstream registration can update NodeStore before SQL commits.
+// Limit+1 detects capacity exhaustion without truncating the frozen roster.
+func (s *State) TKACommittedNodes(ctx context.Context) ([]types.Node, error) {
+	var nodes []types.Node
+	if err := s.db.DB.WithContext(ctx).Preload("User").Order("id").Limit(65).Find(&nodes).Error; err != nil {
+		return nil, err
+	}
+	if len(nodes) > 64 {
+		return nil, errors.New("omnet registry exceeds 64 nodes")
+	}
+	seen := make(map[key.NodePublic]bool, len(nodes))
+	for _, n := range nodes {
+		if n.ID == 0 || n.ID > 1<<63-1 || seen[n.NodeKey] || n.NodeKey.IsZero() {
+			return nil, errors.New("omnet ambiguous committed identity")
+		}
+		seen[n.NodeKey] = true
+		cached, ok := s.GetNodeByID(n.ID)
+		if !ok || cached.NodeKey() != n.NodeKey || cached.MachineKey() != n.MachineKey ||
+			cached.TypedUserID() != n.View().TypedUserID() || !slices.Equal(cached.Tags().AsSlice(), n.Tags) {
+			return nil, errors.New("omnet uncommitted node identity")
+		}
+	}
+	return nodes, nil
+}
+
+// TKAAcknowledge clears only the durable forwarding outbox after Omega accepts
+// it, readback proves acceptance, or a definitive rejection is reconciled by a
+// successful unsigned upsert. Caller holds TKAMu; accepted signatures stay in Omega.
+func (s *State) TKAAcknowledge(ctx context.Context, n types.Node) error {
+	if len(n.TKASignature) == 0 {
+		return nil
+	}
+	if err := s.db.DB.WithContext(ctx).Model(&types.Node{}).Where("id = ?", n.ID).
+		Update("tka_signature", nil).Error; err != nil {
+		return err
+	}
+	s.nodeStore.UpdateNode(n.ID, func(current *types.Node) { current.TKASignature = nil })
+	return nil
+}
+
+// TKARegisterCurrent refreshes authenticated registration metadata, including
+// upstream's no-auth same-key restart fast path. It never grants ownership.
+func (s *State) TKARegisterCurrent(ctx context.Context, req tailcfg.RegisterRequest, machine key.MachinePublic) error {
+	defer s.lockTKA()()
+	nodes, err := s.TKACommittedNodes(ctx)
+	if err != nil {
+		return err
+	}
+	for _, n := range nodes {
+		if n.NodeKey != req.NodeKey {
+			continue
+		}
+		if n.MachineKey != machine || req.NLKey.IsZero() {
+			return errors.New("omnet registration identity mismatch")
+		}
+		if n.TKAKey != req.NLKey || (len(req.NodeKeySignature) != 0 && !bytes.Equal(n.TKASignature, req.NodeKeySignature)) {
+			n.TKAKey = req.NLKey
+			if len(req.NodeKeySignature) != 0 {
+				n.TKASignature = slices.Clone(req.NodeKeySignature)
+			}
+			if err := s.db.DB.WithContext(ctx).Select("TKAKey", "TKASignature").Updates(&n).Error; err != nil {
+				return err
+			}
+			s.nodeStore.UpdateNode(n.ID, func(current *types.Node) {
+				current.TKAKey = n.TKAKey
+				current.TKASignature = slices.Clone(n.TKASignature)
+			})
+		}
+		return s.reconcileTKA(n.ID, req.NodeKeySignature)
+	}
+	return errors.New("omnet registered identity missing")
+}
