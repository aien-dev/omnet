+package hscontrol
+
+import (
+	"bytes"
+	"context"
+	"encoding/binary"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"maps"
+	"net"
+	"net/http"
+	"os"
+	"path/filepath"
+	"slices"
+	"strconv"
+	"sync"
+	"time"
+
+	"github.com/go-chi/chi/v5"
+	"github.com/juanfont/headscale/hscontrol/types"
+	"github.com/juanfont/headscale/hscontrol/types/change"
+	"github.com/rs/zerolog/log"
+	"tailscale.com/tailcfg"
+	"tailscale.com/types/key"
+)
+
+const tkaBodyLimit = 65536
+
+// Reserve enough JSON space for the largest registry tuple and base64 expansion.
+const tkaSignatureLimit = (tkaBodyLimit - 512) / 4 * 3
+const tkaTimeout = 8 * time.Second
+
+var errTKAUnavailable = errors.New("omnet authority unavailable or registration pending")
+
+// This is transport glue. Omega alone parses TKA RPCs, verifies signatures,
+// chooses authority state and decides enablement/disablement. The local socket
+// profile trusts the same UID; it is not a separate-UID security boundary.
+type tkaAdapter struct {
+	h            *Headscale
+	socket       string
+	owner        uint64
+	revision     uint64 // accessed under State.TKAMu
+	haveRevision bool
+	healthMu     sync.Mutex
+	failed       chan struct{}
+	healthy      bool
+}
+
+type tkaRegistryNode struct {
+	NodeID         types.NodeID
+	NodePublic     key.NodePublic
+	RotationPubkey []byte
+	KeySignature   []byte
+}
+
+type tkaSnapshot struct {
+	TKAInfo  *tailcfg.TKAInfo
+	Revision uint64
+	Nodes    []tkaRegistryNode
+}
+
+func (h *Headscale) initTKA() error {
+	socket, ownerText := os.Getenv("OMNET_TKAD_SOCKET"), os.Getenv("OMNET_TKAD_ADMIN_USER_ID")
+	if socket == "" && ownerText == "" {
+		return nil
+	}
+	owner, err := strconv.ParseUint(ownerText, 10, 64)
+	if err != nil || owner == 0 || !filepath.IsAbs(socket) {
+		return errors.New("OMNET_TKAD_SOCKET must be absolute and OMNET_TKAD_ADMIN_USER_ID must be positive")
+	}
+	a := &tkaAdapter{h: h, socket: socket, owner: owner, failed: make(chan struct{}), healthy: true}
+	h.tkad = a
+	h.state.TKAReconcile = a.reconcileRegistration
+	h.state.TKAMu.Lock()
+	defer h.state.TKAMu.Unlock()
+	ctx, cancel := context.WithTimeout(context.Background(), tkaTimeout)
+	defer cancel()
+	if _, err := a.readSnapshot(ctx); err != nil {
+		return err
+	}
+	if _, _, err := a.reconcile(ctx); err != nil {
+		// Keep control available for authenticated retries/admin deletion,
+		// but no map or TKA RPC may pass the reconciliation barrier.
+		log.Warn().Err(err).Msg("omnet registry pending; control publication blocked")
+	}
+	return nil
+}
+
+func (a *tkaAdapter) health(ok bool) {
+	a.healthMu.Lock()
+	defer a.healthMu.Unlock()
+	if !ok && a.healthy {
+		close(a.failed)
+	} else if ok && !a.healthy {
+		a.failed = make(chan struct{})
+	}
+	a.healthy = ok
+}
+
+func (h *Headscale) tkaFailure() <-chan struct{} {
+	if h.tkad == nil {
+		return nil
+	}
+	h.tkad.healthMu.Lock()
+	defer h.tkad.healthMu.Unlock()
+	return h.tkad.failed
+}
+
+// rpc exchanges one bounded, deadline-limited IPC frame. A lost reply is not
+// a rollback indication; durable registration outboxes are reconciled by read.
+func (a *tkaAdapter) rpc(ctx context.Context, route byte, admin bool, nodeID types.NodeID, body []byte) (_ int, _ []byte, retErr error) {
+	if len(body) > tkaBodyLimit {
+		return 0, nil, errors.New("omnet request too large")
+	}
+	parent := ctx
+	defer func() {
+		if retErr != nil && parent.Err() == nil {
+			a.health(false)
+		}
+	}()
+	ctx, cancel := context.WithTimeout(ctx, tkaTimeout)
+	defer cancel()
+	conn, err := (&net.Dialer{}).DialContext(ctx, "unix", a.socket)
+	if err != nil {
+		return 0, nil, errTKAUnavailable
+	}
+	defer conn.Close()
+	deadline, _ := ctx.Deadline()
+	if err := conn.SetDeadline(deadline); err != nil {
+		return 0, nil, errTKAUnavailable
+	}
+	var header [20]byte
+	copy(header[:4], "TKA\x01")
+	header[4] = route
+	if admin {
+		header[5] = 1
+	}
+	binary.LittleEndian.PutUint64(header[8:16], uint64(nodeID))
+	binary.LittleEndian.PutUint32(header[16:20], uint32(len(body)))
+	for _, part := range [][]byte{header[:], body} {
+		for len(part) > 0 {
+			n, err := conn.Write(part)
+			if err != nil || n == 0 {
+				return 0, nil, errTKAUnavailable
+			}
+			part = part[n:]
+		}
+	}
+	var response [12]byte
+	if _, err := io.ReadFull(conn, response[:]); err != nil {
+		return 0, nil, errTKAUnavailable
+	}
+	status := int(binary.LittleEndian.Uint16(response[4:6]))
+	length := binary.LittleEndian.Uint32(response[8:12])
+	if string(response[:4]) != "TKA\x01" || response[6] != 0 || response[7] != 0 ||
+		length > tkaBodyLimit || status < 200 || status > 599 {
+		return 0, nil, errTKAUnavailable
+	}
+	result := make([]byte, int(length))
+	if _, err := io.ReadFull(conn, result); err != nil {
+		return 0, nil, errTKAUnavailable
+	}
+	return status, result, nil
+}
+
+func (a *tkaAdapter) readSnapshot(ctx context.Context) (*tkaSnapshot, error) {
+	status, body, err := a.rpc(ctx, 11, true, 0, []byte("{}"))
+	if err != nil || status != http.StatusOK {
+		return nil, errTKAUnavailable
+	}
+	var wire struct {
+		TKAInfo  json.RawMessage
+		Revision *uint64
+		Nodes    *[]tkaRegistryNode
+	}
+	if err := json.Unmarshal(body, &wire); err != nil || wire.Revision == nil ||
+		wire.Nodes == nil || len(wire.TKAInfo) == 0 || len(*wire.Nodes) > 64 {
+		return nil, errTKAUnavailable
+	}
+	snap := tkaSnapshot{Revision: *wire.Revision, Nodes: *wire.Nodes}
+	if err := json.Unmarshal(wire.TKAInfo, &snap.TKAInfo); err != nil {
+		return nil, errTKAUnavailable
+	}
+	seen := make(map[types.NodeID]bool, len(snap.Nodes))
+	keys := make(map[key.NodePublic]bool, len(snap.Nodes))
+	for _, n := range snap.Nodes {
+		if n.NodeID == 0 || n.NodeID > 1<<63-1 || n.NodePublic.IsZero() ||
+			len(n.RotationPubkey) != 32 || seen[n.NodeID] || keys[n.NodePublic] {
+			return nil, errTKAUnavailable
+		}
+		seen[n.NodeID], keys[n.NodePublic] = true, true
+	}
+	if a.haveRevision && snap.Revision < a.revision {
+		return nil, errors.New("omnet authority revision regressed")
+	}
+	if err := a.h.state.TKACheckRevision(ctx, snap.Revision); err != nil {
+		return nil, err
+	}
+	return &snap, nil
+}
+
+// reconcile runs under the shared identity/publication barrier. SQL is the
+// desired registry; Omega is the only accepted-signature store. Exact reads
+// suppress unchanged writes, so adapter restart preserves pending init.
+func (a *tkaAdapter) reconcile(ctx context.Context) (_ *tkaSnapshot, _ []types.Node, retErr error) {
+	if err := ctx.Err(); err != nil {
+		return nil, nil, err
+	}
+	// A disconnected requester cannot cancel a shared persistence/publication
+	// barrier and thereby declare the daemon unhealthy for every other node.
+	ctx, cancel := context.WithTimeout(context.WithoutCancel(ctx), tkaTimeout)
+	defer cancel()
+	defer func() { a.health(retErr == nil) }()
+	nodes, err := a.h.state.TKACommittedNodes(ctx)
+	if err != nil {
+		return nil, nil, err
+	}
+	snap, err := a.readSnapshot(ctx)
+	if err != nil {
+		return nil, nil, err
+	}
+	current := make(map[types.NodeID]tkaRegistryNode, len(snap.Nodes))
+	desired := make(map[types.NodeID]key.NodePublic, len(nodes))
+	for _, n := range snap.Nodes {
+		current[n.NodeID] = n
+	}
+	for _, n := range nodes {
+		desired[n.ID] = n.NodeKey
+		if n.TKAKey.IsZero() {
+			return nil, nil, errors.New("omnet node lacks authenticated NLKey; re-register it")
+		}
+	}
+	mutated := false
+	// Vacate all obsolete keys before claiming any desired key, including
+	// cycles after an outage. A changed key cannot retain its old signature.
+	for _, n := range snap.Nodes {
+		if desired[n.NodeID] == n.NodePublic {
+			continue
+		}
+		body, _ := json.Marshal(struct{ NodeID types.NodeID }{n.NodeID})
+		status, _, err := a.rpc(ctx, 10, true, 0, body)
+		if err != nil || status != http.StatusOK {
+			return nil, nil, errTKAUnavailable
+		}
+		mutated = true
+		delete(current, n.NodeID)
+	}
+	for _, n := range nodes {
+		old, found := current[n.ID]
+		tupleMatches := found && old.NodePublic == n.NodeKey && bytes.Equal(old.RotationPubkey, n.TKAKey.Verifier())
+		sigMatches := len(n.TKASignature) == 0 || bytes.Equal(old.KeySignature, n.TKASignature)
+		if !tupleMatches || !sigMatches {
+			upsert := struct {
+				NodeID         types.NodeID
+				NodeKey        key.NodePublic
+				RotationPubkey []byte
+				Signature      []byte `json:",omitempty"`
+			}{n.ID, n.NodeKey, n.TKAKey.Verifier(), n.TKASignature}
+			body, err := json.Marshal(upsert)
+			if err != nil {
+				return nil, nil, err
+			}
+			status := http.StatusRequestEntityTooLarge
+			if len(body) <= tkaBodyLimit {
+				status, _, err = a.rpc(ctx, 9, true, 0, body)
+			}
+			if err != nil {
+				// A lost reply may have committed. Preserve the outbox until
+				// accepted readback or a definitive response resolves it.
+				return nil, nil, err
+			}
+			if len(upsert.Signature) != 0 && (status == http.StatusBadRequest ||
+				status == http.StatusForbidden || status == http.StatusConflict ||
+				(status == http.StatusRequestEntityTooLarge && len(body) > tkaBodyLimit)) {
+				// These are the pinned daemon's invalid/malformed/inactive
+				// signature responses. Require an unsigned upsert to succeed:
+				// an admin/identity rejection must not be reported as success.
+				// Same-key omission preserves Omega's accepted signature;
+				// a changed key becomes unsigned, never authorized by this glue.
+				upsert.Signature = nil
+				body, err = json.Marshal(upsert)
+				if err != nil {
+					return nil, nil, err
+				}
+				status, _, err = a.rpc(ctx, 9, true, 0, body)
+			}
+			if err != nil || status != http.StatusOK {
+				return nil, nil, errTKAUnavailable
+			}
+			mutated = true
+		}
+		if err := a.h.state.TKAAcknowledge(ctx, n); err != nil {
+			return nil, nil, err
+		}
+	}
+	if mutated {
+		snap, err = a.readSnapshot(ctx)
+		if err != nil {
+			return nil, nil, err
+		}
+	}
+	if !a.haveRevision || snap.Revision != a.revision {
+		a.revision, a.haveRevision = snap.Revision, true
+		if a.h.mapBatcher != nil {
+			a.h.Change(change.FullUpdate())
+		}
+	}
+	return snap, nodes, nil
+}
+
+// Registration success must not conceal a rejected submitted signature. An
+// unrelated node's rejected outbox does not fail this caller or global health.
+func (a *tkaAdapter) reconcileRegistration(ctx context.Context, id types.NodeID, signature []byte) error {
+	snap, _, err := a.reconcile(ctx)
+	if err != nil || len(signature) == 0 {
+		return err
+	}
+	for _, n := range snap.Nodes {
+		if n.NodeID == id && bytes.Equal(n.KeySignature, signature) {
+			return nil
+		}
+	}
+	// Authentication may already have committed ownership/policy changes even
+	// when the same-key unsigned retry leaves Omega's revision unchanged.
+	if a.h.mapBatcher != nil {
+		a.h.Change(change.FullUpdate())
+	}
+	return errors.New("omnet rejected node key signature")
+}
+
+func (h *Headscale) watchTKA(ctx context.Context) {
+	if h.tkad == nil {
+		return
+	}
+	ticker := time.NewTicker(time.Second)
+	defer ticker.Stop()
+	for {
+		select {
+		case <-ctx.Done():
+			return
+		case <-ticker.C:
+			h.state.TKAMu.Lock()
+			checkCtx, cancel := context.WithTimeout(ctx, tkaTimeout)
+			_, _, _ = h.tkad.reconcile(checkCtx)
+			cancel()
+			h.state.TKAMu.Unlock()
+		}
+	}
+}
+
+func (ns *noiseServer) tkaRoutes(r chi.Router) {
+	for route, path := range []string{"/init/begin", "/init/finish", "/bootstrap", "/sync/offer", "/sync/send", "/disable", "/sign", "/affected-sigs"} {
+		r.Get("/tka"+path, func(w http.ResponseWriter, req *http.Request) { ns.tkaRPC(w, req, byte(route+1)) })
+	}
+}
+
+func (ns *noiseServer) tkaRPC(w http.ResponseWriter, req *http.Request, route byte) {
+	a := ns.headscale.tkad
+	if a == nil {
+		http.Error(w, "omnet not configured", http.StatusServiceUnavailable)
+		return
+	}
+	controller := http.NewResponseController(w)
+	_ = controller.SetReadDeadline(time.Now().Add(tkaTimeout))
+	body, err := io.ReadAll(io.LimitReader(req.Body, tkaBodyLimit+1))
+	_ = controller.SetReadDeadline(time.Time{})
+	if err != nil || len(body) > tkaBodyLimit {
+		http.Error(w, "invalid omnet body", http.StatusRequestEntityTooLarge)
+		return
+	}
+	// This decode selects an identity only. The original bytes are forwarded
+	// unchanged; Omega independently rejects duplicate fields and binds NodeKey.
+	var selector struct{ NodeKey key.NodePublic }
+	if json.Unmarshal(body, &selector) != nil || selector.NodeKey.IsZero() {
+		http.Error(w, "invalid omnet identity", http.StatusBadRequest)
+		return
+	}
+	status, reply, err := func() (int, []byte, error) {
+		a.h.state.TKAMu.Lock()
+		defer a.h.state.TKAMu.Unlock()
+		if err := req.Context().Err(); err != nil {
+			return http.StatusServiceUnavailable, nil, err
+		}
+		ctx, cancel := context.WithTimeout(context.WithoutCancel(req.Context()), tkaTimeout)
+		defer cancel()
+		_, nodes, err := a.reconcile(ctx)
+		if err != nil {
+			return http.StatusServiceUnavailable, nil, errTKAUnavailable
+		}
+		var caller *types.Node
+		for i := range nodes {
+			if nodes[i].NodeKey == selector.NodeKey && nodes[i].MachineKey == ns.machineKey {
+				caller = &nodes[i]
+			}
+		}
+		if caller == nil {
+			return http.StatusUnauthorized, nil, errors.New("unauthorized omnet identity")
+		}
+		admin := !caller.IsExpired() && !caller.IsTagged() && caller.UserID != nil && uint64(*caller.UserID) == a.owner
+		status, reply, err := a.rpc(ctx, route, admin, caller.ID, body)
+		if err != nil {
+			// This is our detached IPC deadline, not caller cancellation.
+			// A lost mutation reply must stop publication until readback.
+			a.health(false)
+			return http.StatusServiceUnavailable, nil, errTKAUnavailable
+		}
+		// A successful mutation is not retried because notification fails.
+		if status == http.StatusOK && a.h.mapBatcher != nil {
+			a.h.Change(change.FullUpdate())
+		}
+		return status, reply, nil
+	}()
+	_ = controller.SetWriteDeadline(time.Now().Add(tkaTimeout))
+	defer controller.SetWriteDeadline(time.Time{})
+	if err != nil {
+		http.Error(w, err.Error(), status)
+		return
+	}
+	w.Header().Set("Content-Type", "application/json")
+	w.WriteHeader(status)
+	_, _ = w.Write(reply)
+}
+
+// registrationPrelude supplies the stock client's two-step signature challenge
+// before upstream authentication. Possession of the old Noise identity never
+// substitutes for interactive reauthentication, including for unexpired nodes.
+func (h *Headscale) registrationPrelude(ctx context.Context, req tailcfg.RegisterRequest, machine key.MachinePublic) (*tailcfg.RegisterResponse, error) {
+	if h.tkad == nil {
+		return nil, nil
+	}
+	if req.NodeKey.IsZero() || req.NLKey.IsZero() || len(req.NodeKeySignature) > tkaSignatureLimit {
+		return nil, errors.New("omnet requires nonzero NodeKey, NLKey and bounded signature")
+	}
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	h.state.TKAMu.Lock()
+	defer h.state.TKAMu.Unlock()
+	ctx, cancel := context.WithTimeout(context.WithoutCancel(ctx), tkaTimeout)
+	defer cancel()
+	snap, err := h.tkad.readSnapshot(ctx)
+	if err != nil {
+		h.tkad.health(false)
+		return nil, err
+	}
+	nodes, err := h.state.TKACommittedNodes(ctx)
+	if err != nil {
+		return nil, err
+	}
+	for _, n := range nodes {
+		if n.NodeKey != req.OldNodeKey || n.NodeKey == req.NodeKey {
+			continue
+		}
+		if n.MachineKey != machine {
+			return nil, errors.New("omnet old node belongs to another Noise identity")
+		}
+		for _, stored := range snap.Nodes {
+			if stored.NodeID == n.ID && stored.NodePublic == n.NodeKey &&
+				len(stored.KeySignature) > 0 && len(req.NodeKeySignature) == 0 {
+				return &tailcfg.RegisterResponse{NodeKeySignature: stored.KeySignature}, nil
+			}
+		}
+	}
+	return nil, nil
+}
+
+func (h *Headscale) tkaMapReady(ctx context.Context) error {
+	if h.tkad == nil {
+		return nil
+	}
+	h.state.TKAMu.Lock()
+	defer h.state.TKAMu.Unlock()
+	ctx, cancel := context.WithTimeout(ctx, tkaTimeout)
+	defer cancel()
+	_, _, err := h.tkad.reconcile(ctx)
+	return err
+}
+
+// encodeTKAMap is the last publication barrier, including already queued maps.
+// A stale key or stale authenticated session closes the stream instead of
+// pairing an old identity with a current signature (or publishing a fallback).
+func (m *mapSession) encodeTKAMap(msg *tailcfg.MapResponse) ([]byte, error) {
+	a := m.h.tkad
+	m.h.state.TKAMu.Lock()
+	defer m.h.state.TKAMu.Unlock()
+	ctx, cancel := context.WithTimeout(m.ctx, tkaTimeout)
+	defer cancel()
+	snap, nodes, err := a.reconcile(ctx)
+	if err != nil {
+		return nil, err
+	}
+	validSession := false
+	for _, n := range nodes {
+		if n.ID == m.node.ID && n.NodeKey == m.req.NodeKey && n.MachineKey == m.node.MachineKey {
+			validSession = true
+		}
+	}
+	if !validSession {
+		return nil, errors.New("stale omnet map session")
+	}
+	// A PeerChange cannot clear a previous signature with nil. Rebuild key
+	// patches as full nodes, including an unsigned rotation, before publication.
+	for _, patch := range msg.PeersChangedPatch {
+		if patch.Key != nil {
+			full, err := m.h.mapBatcher.FullMapResponse(m.node.ID, m.capVer)
+			if err != nil {
+				return nil, err
+			}
+			full.PingRequest = msg.PingRequest
+			msg = full
+			break
+		}
+	}
+	copyNode := func(n *tailcfg.Node) *tailcfg.Node {
+		if n == nil {
+			return nil
+		}
+		copied := *n
+		return &copied
+	}
+	out := new(tailcfg.MapResponse)
+	*out = *msg
+	out.Node = copyNode(msg.Node)
+	out.Peers = slices.Clone(msg.Peers)
+	for i, n := range out.Peers {
+		out.Peers[i] = copyNode(n)
+	}
+	out.PeersChanged = slices.Clone(msg.PeersChanged)
+	for i, n := range out.PeersChanged {
+		out.PeersChanged[i] = copyNode(n)
+	}
+	out.PeersChangedPatch = slices.Clone(msg.PeersChangedPatch)
+	for i, patch := range out.PeersChangedPatch {
+		copied := *patch
+		out.PeersChangedPatch[i] = &copied
+	}
+	out.TKAInfo = snap.TKAInfo
+	registry := make(map[types.NodeID]tkaRegistryNode, len(snap.Nodes))
+	for _, n := range snap.Nodes {
+		registry[n.NodeID] = n
+	}
+	decorate := func(n *tailcfg.Node) error {
+		if n == nil {
+			return nil
+		}
+		stored, ok := registry[types.NodeID(n.ID)]
+		if !ok || stored.NodePublic != n.Key {
+			return errors.New("stale omnet map node")
+		}
+		n.KeySignature = stored.KeySignature
+		return nil
+	}
+	if err := decorate(out.Node); err != nil {
+		return nil, err
+	}
+	if out.Node != nil {
+		out.Node.CapMap = maps.Clone(out.Node.CapMap)
+		if out.Node.CapMap == nil {
+			out.Node.CapMap = make(tailcfg.NodeCapMap)
+		}
+		out.Node.CapMap[tailcfg.CapabilityTailnetLock] = nil
+	}
+	for _, n := range out.Peers {
+		if err := decorate(n); err != nil {
+			return nil, err
+		}
+	}
+	for _, n := range out.PeersChanged {
+		if err := decorate(n); err != nil {
+			return nil, err
+		}
+	}
+	for _, patch := range out.PeersChangedPatch {
+		if _, ok := registry[types.NodeID(patch.NodeID)]; !ok {
+			return nil, errors.New("stale omnet map patch")
+		}
+		// A non-key patch may be queued behind a rotation. It cannot safely
+		// attach the new key's signature to the client's previous key.
+		patch.KeySignature = nil
+	}
+	return encodeMapResponse(m.req.Compress, out)
+}
+
+// Each session's poll loop is a single writer, preserving frame order. The
+// coherent frame is frozen under TKAMu, but no client I/O holds the barrier.
+func (m *mapSession) writeTKAMap(msg *tailcfg.MapResponse) error {
+	if m.h.tkad == nil {
+		return writeMapResponse(m.w, m.req.Compress, m.isStreaming(), msg)
+	}
+	frame, err := m.encodeTKAMap(msg)
+	if err != nil {
+		return err
+	}
+	m.writeDeadlineMu.Lock()
+	if m.cancelChClosed.Load() {
+		m.writeDeadlineMu.Unlock()
+		return errMapSessionStopped
+	}
+	if err := m.ctx.Err(); err != nil {
+		m.writeDeadlineMu.Unlock()
+		return err
+	}
+	controller := http.NewResponseController(m.w)
+	err = controller.SetWriteDeadline(time.Now().Add(tkaTimeout))
+	m.writeDeadlineMu.Unlock()
+	if err != nil && !errors.Is(err, http.ErrNotSupported) {
+		return fmt.Errorf("omnet write deadline: %w", err)
+	}
+	defer func() {
+		m.writeDeadlineMu.Lock()
+		defer m.writeDeadlineMu.Unlock()
+		_ = controller.SetWriteDeadline(time.Time{})
+	}()
+	return writeMapFrame(m.w, m.isStreaming(), frame)
+}
