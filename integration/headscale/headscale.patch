+func TestOmnetRPCWritesOutsidePublicationBarrier(t *testing.T) {
+	for _, authorized := range []bool{false, true} {
+		t.Run(fmt.Sprintf("authorized=%t", authorized), func(t *testing.T) {
+			h, n, _ := omnetApp(t)
+			machine := n.MachineKey
+			if !authorized {
+				machine = key.NewMachine().Public()
+			}
+			ns := &noiseServer{headscale: h, machineKey: machine}
+			w := &omnetBlockedWriter{ResponseRecorder: httptest.NewRecorder(), started: make(chan struct{}), release: make(chan struct{})}
+			body := []byte(fmt.Sprintf("{\"NodeKey\":%q}", n.NodeKey.String()))
+			done := make(chan struct{})
+			go func() {
+				ns.tkaRPC(w, httptest.NewRequest(http.MethodGet, "/", bytes.NewReader(body)), 1)
+				close(done)
+			}()
+			<-w.started
+			locked := h.state.TKAMu.TryLock()
+			if locked {
+				h.state.TKAMu.Unlock()
+			}
+			close(w.release)
+			<-done
+			require.True(t, locked, "both success and error writes must release the barrier")
+			want := http.StatusUnauthorized
+			if authorized {
+				want = http.StatusOK
+			}
+			require.Equal(t, want, w.Code)
+		})
+	}
+}
