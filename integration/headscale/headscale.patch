+func TestOmnetKeyReuseRecoveryVacatesAllKeysFirst(t *testing.T) {
+	for _, lostRemovalReply := range []bool{false, true} {
+		t.Run(fmt.Sprintf("lost-removal=%t", lostRemovalReply), func(t *testing.T) {
+			h, first, f := omnetApp(t)
+			otherUser := h.state.CreateUserForTest("reuse-peer")
+			second := h.state.CreateRegisteredNodeForTest(otherUser, "reuse-peer")
+			second.TKAKey = key.NewNLPrivate().Public()
+			oldFirst, oldSecond := first.NodeKey, second.NodeKey
+			f.mu.Lock()
+			f.snapshot.Nodes = append(f.snapshot.Nodes, tkaRegistryNode{second.ID, oldSecond, second.TKAKey.Verifier(), nil})
+			if lostRemovalReply {
+				f.dropReplyRoute = 10
+			}
+			f.mu.Unlock()
+			// A cycle is stronger than row ordering: neither key can be claimed
+			// until both old holders have been removed.
+			first.NodeKey, second.NodeKey = oldSecond, oldFirst
+			first.TKASignature, second.TKASignature = []byte("first-new"), []byte("second-new")
+			require.NoError(t, h.state.DB().DB.Save(&first).Error)
+			require.NoError(t, h.state.DB().DB.Save(second).Error)
+			h.state.PutNodeInStoreForTest(first)
+			h.state.PutNodeInStoreForTest(*second)
+			if lostRemovalReply {
+				require.Error(t, h.tkaMapReady(context.Background()))
+				stored, err := h.state.DB().GetNodeByID(first.ID)
+				require.NoError(t, err)
+				require.Equal(t, first.TKASignature, stored.TKASignature)
+			}
+			require.NoError(t, h.tkaMapReady(context.Background()))
+			f.mu.Lock()
+			require.Len(t, f.snapshot.Nodes, 2)
+			for _, got := range f.snapshot.Nodes {
+				want := first
+				if got.NodeID == second.ID {
+					want = *second
+				}
+				require.Equal(t, want.NodeKey, got.NodePublic)
+				require.Equal(t, want.TKASignature, got.KeySignature)
+			}
+			mutations := slices.DeleteFunc(slices.Clone(f.calls), func(route byte) bool { return route == 11 })
+			require.Equal(t, []byte{10, 10, 9, 9}, mutations, "vacate before claim, even after an ambiguous removal")
+			f.mu.Unlock()
+		})
+	}
+}
