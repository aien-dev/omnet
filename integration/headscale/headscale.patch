+func omnetSocket(t *testing.T, f *omnetFixture) string {
+	t.Helper()
+	path := filepath.Join(t.TempDir(), "t.sock")
+	listener, err := net.Listen("unix", path)
+	require.NoError(t, err)
+	t.Cleanup(func() { _ = listener.Close() })
+	go func() {
+		for {
+			conn, err := listener.Accept()
+			if err != nil {
+				return
+			}
+			func() {
+				defer conn.Close()
+				var hdr [20]byte
+				if _, err := io.ReadFull(conn, hdr[:]); err != nil {
+					return
+				}
+				length := binary.LittleEndian.Uint32(hdr[16:20])
+				if length > tkaBodyLimit {
+					return
+				}
+				body := make([]byte, length)
+				if _, err := io.ReadFull(conn, body); err != nil {
+					return
+				}
+				f.mu.Lock()
+				defer f.mu.Unlock()
+				f.calls = append(f.calls, hdr[4])
+				reply := []byte("{\"opaque\":true}")
+				status := http.StatusOK
+				switch hdr[4] {
+				case 9:
+					var n struct {
+						NodeID         types.NodeID
+						NodeKey        key.NodePublic
+						RotationPubkey []byte
+						Signature      []byte
+					}
+					if json.Unmarshal(body, &n) != nil {
+						return
+					}
+					if len(n.Signature) != 0 && f.rejectSignature != 0 {
+						status = f.rejectSignature
+						break
+					}
+					if len(n.Signature) == 0 && f.rejectUnsigned != 0 {
+						status = f.rejectUnsigned
+						break
+					}
+					if slices.ContainsFunc(f.snapshot.Nodes, func(x tkaRegistryNode) bool {
+						return x.NodeID != n.NodeID && x.NodePublic == n.NodeKey
+					}) {
+						status = http.StatusConflict
+						break
+					}
+					oldIndex := slices.IndexFunc(f.snapshot.Nodes, func(x tkaRegistryNode) bool { return x.NodeID == n.NodeID })
+					newNode := tkaRegistryNode{n.NodeID, n.NodeKey, n.RotationPubkey, n.Signature}
+					if oldIndex >= 0 {
+						old := f.snapshot.Nodes[oldIndex]
+						if len(n.Signature) == 0 && old.NodePublic == n.NodeKey {
+							newNode.KeySignature = old.KeySignature
+						}
+						f.snapshot.Nodes[oldIndex] = newNode
+					} else {
+						f.snapshot.Nodes = append(f.snapshot.Nodes, newNode)
+					}
+					f.writes++
+					f.snapshot.Revision++
+				case 10:
+					var n struct{ NodeID types.NodeID }
+					if json.Unmarshal(body, &n) != nil {
+						return
+					}
+					f.snapshot.Nodes = slices.DeleteFunc(f.snapshot.Nodes, func(x tkaRegistryNode) bool { return x.NodeID == n.NodeID })
+					f.writes++
+					f.snapshot.Revision++
+				case 11:
+					reply, _ = json.Marshal(f.snapshot)
+					if f.badRead {
+						reply = []byte("{}")
+					}
+				default:
+					f.lastHeader = hdr
+					if (hdr[4] == 1 || hdr[4] == 2 || hdr[4] == 6) && hdr[5] == 0 {
+						status = http.StatusForbidden
+					}
+				}
+				if f.beforeReply != nil {
+					f.beforeReply(hdr[4])
+				}
+				if f.dropReplyRoute == hdr[4] {
+					f.dropReplyRoute = 0
+					return
+				}
+				var response [12]byte
+				copy(response[:], "TKA\x01")
+				binary.LittleEndian.PutUint16(response[4:6], uint16(status))
+				binary.LittleEndian.PutUint32(response[8:], uint32(len(reply)))
+				_, _ = conn.Write(response[:])
+				_, _ = conn.Write(reply)
+			}()
+		}
+	}()
+	return path
+}
