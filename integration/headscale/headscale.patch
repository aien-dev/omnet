+func TestOmnetCancelledClientDoesNotFailGlobalHealth(t *testing.T) {
+	h, n, f := omnetApp(t)
+	failure := h.tkaFailure()
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	w := httptest.NewRecorder()
+	m := &mapSession{h: h, ctx: ctx, req: tailcfg.MapRequest{NodeKey: n.NodeKey}, node: &n, w: w}
+	require.ErrorIs(t, m.writeTKAMap(&tailcfg.MapResponse{KeepAlive: true}), context.Canceled)
+	require.ErrorIs(t, h.tkaMapReady(ctx), context.Canceled)
+	_, _, err := h.tkad.rpc(ctx, 11, true, 0, []byte("{}"))
+	require.Error(t, err)
+	// Also disconnect after reconciliation has started a live daemon read.
+	ctx, cancel = context.WithCancel(context.Background())
+	m.ctx = ctx
+	started, release := make(chan struct{}), make(chan struct{})
+	var once sync.Once
+	f.mu.Lock()
+	f.beforeReply = func(route byte) {
+		if route == 11 {
+			once.Do(func() { close(started); <-release })
+		}
+	}
+	f.mu.Unlock()
+	done := make(chan error, 1)
+	go func() { done <- m.writeTKAMap(&tailcfg.MapResponse{KeepAlive: true}) }()
+	<-started
+	cancel()
+	close(release)
+	require.ErrorIs(t, <-done, context.Canceled)
+	require.Empty(t, w.Body.Bytes())
+	select {
+	case <-failure:
+		t.Fatal("client cancellation closed another client's failure channel")
+	default:
+	}
+	require.NoError(t, h.tkaMapReady(context.Background()))
+}
